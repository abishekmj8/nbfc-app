# Database — SQLite (default dev), PostgreSQL, or MySQL
# SQLite:     file:./dev.db
# PostgreSQL: postgresql://user:password@localhost:5432/nbfc
# MySQL:      mysql://user:password@localhost:3306/nbfc
DATABASE_URL="file:./dev.db"

# App secret — used for session encryption. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-this-to-a-random-secret-in-production"

# App URL — where the app is hosted
APP_URL="http://localhost:3000"

# File storage — local (default) or s3
FILE_STORAGE_TYPE="local"
FILE_STORAGE_PATH="./uploads"

# S3-compatible storage (when FILE_STORAGE_TYPE=s3)
# S3_ENDPOINT=""
# S3_BUCKET=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_REGION=""

# Email / SMTP (optional)
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="noreply@yourcompany.com"

# SMS — MSG91 (optional, logs to console if not set)
# MSG91_AUTH_KEY=""
# MSG91_SENDER_ID="NBFCMG"

# Payment Automation — Razorpay (optional)
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""

# Cron job auth (used by daily accrual/DPD endpoints)
# CRON_SECRET="your-cron-secret-here"
