generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// CORE: Company & Branch
// ============================================================

model Company {
  id                  String   @id @default(cuid())
  name                String
  rbiRegistrationNo   String?
  panNumber           String?
  gstNumber           String?
  address             String?
  city                String?
  state               String?
  pincode             String?
  phone               String?
  email               String?
  website             String?
  logoUrl             String?
  primaryColor        String   @default("#1e40af")
  accentColor         String   @default("#3b82f6")
  financialYearStart  Int      @default(4) // Month number (4 = April)
  sbrLayer            String   @default("BASE") // BASE | MIDDLE | UPPER | TOP
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  branches Branch[]
  users    User[]
  roles    Role[]
  holidays Holiday[]
}

model Branch {
  id           String    @id @default(cuid())
  companyId    String
  name         String
  code         String
  address      String?
  city         String?
  state        String?
  pincode      String?
  phone        String?
  email        String?
  timezone     String    @default("Asia/Kolkata")
  isHeadOffice Boolean   @default(false)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  company Company @relation(fields: [companyId], references: [id])
  users   User[]

  @@unique([companyId, code])
  @@index([companyId])
}

// ============================================================
// CORE: Users, Roles, Permissions, Sessions
// ============================================================

model User {
  id              String    @id @default(cuid())
  companyId       String
  branchId        String?
  email           String
  passwordHash    String
  firstName       String
  lastName        String?
  phone           String?
  roleId          String
  status          String    @default("ACTIVE") // ACTIVE | DEACTIVATED
  preferredLocale String    @default("en")
  lastLoginAt     DateTime?
  passwordChangedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  createdBy       String?
  updatedBy       String?

  company  Company   @relation(fields: [companyId], references: [id])
  branch   Branch?   @relation(fields: [branchId], references: [id])
  role     Role      @relation(fields: [roleId], references: [id])
  sessions Session[]

  @@unique([companyId, email])
  @@index([companyId])
  @@index([branchId])
  @@index([roleId])
}

model Role {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  isSystem    Boolean  @default(false) // System roles can't be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id])
  permissions Permission[]
  users       User[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Permission {
  id     String @id @default(cuid())
  roleId String
  module String // e.g., "loans", "customers", "settings"
  action String // VIEW | CREATE | EDIT | APPROVE | DELETE

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, module, action])
  @@index([roleId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// ============================================================
// CORE: Audit Trail
// ============================================================

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String?
  userId     String?
  userEmail  String?
  action     String   // CREATE | UPDATE | DELETE | LOGIN | LOGOUT | EXPORT | etc.
  entityType String   // e.g., "User", "LoanAccount", "Payment"
  entityId   String?
  before     String?  // JSON snapshot before change
  after      String?  // JSON snapshot after change
  ipAddress  String?
  userAgent  String?
  metadata   String?  // Additional context (JSON)
  createdAt  DateTime @default(now())

  @@index([companyId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

// ============================================================
// CORE: System Configuration
// ============================================================

model SystemConfig {
  id        String   @id @default(cuid())
  companyId String?
  key       String
  value     String   // JSON-encoded value
  updatedAt DateTime @updatedAt

  @@unique([companyId, key])
}

// ============================================================
// CORE: Holiday Calendar
// ============================================================

model Holiday {
  id        String   @id @default(cuid())
  companyId String
  branchId  String?  // null = company-wide
  name      String
  date      DateTime
  type      String   @default("CUSTOM") // NATIONAL | STATE | CUSTOM
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  createdBy String?

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([date])
}

// ============================================================
// CUSTOMERS
// ============================================================

model Customer {
  id              String    @id @default(cuid())
  companyId       String
  branchId        String?
  customerCode    String?   // Auto-generated or manual
  firstName       String
  lastName        String?
  fatherName      String?
  dateOfBirth     DateTime?
  gender          String?   // MALE | FEMALE | OTHER
  maritalStatus   String?   // SINGLE | MARRIED | WIDOWED | DIVORCED
  occupation      String?
  employerName    String?
  monthlyIncome   BigInt?   // paise
  phone           String
  alternatePhone  String?
  email           String?
  photoUrl        String?
  preferredLanguage String  @default("en")
  customerType    String    @default("INDIVIDUAL") // INDIVIDUAL | CORPORATE | PARTNERSHIP | TRUST
  riskCategory    String    @default("LOW") // LOW | MEDIUM | HIGH
  kycStatus       String    @default("PENDING") // PENDING | PARTIAL | VERIFIED | EXPIRED
  status          String    @default("ACTIVE") // ACTIVE | INACTIVE | BLACKLISTED
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  createdBy       String?
  updatedBy       String?

  identities      CustomerIdentity[]
  addresses       CustomerAddress[]
  bankAccounts    CustomerBankAccount[]
  consents        ConsentRecord[]

  @@unique([companyId, customerCode])
  @@index([companyId])
  @@index([branchId])
  @@index([phone])
  @@index([status])
}

model CustomerIdentity {
  id              String    @id @default(cuid())
  customerId      String
  documentType    String    // PAN | AADHAAR | VOTER_ID | PASSPORT | DRIVING_LICENSE
  documentNumber  String?   // Encrypted for PAN; null for Aadhaar (use vault)
  maskedNumber    String?   // Last 4 digits or masked version for display
  aadhaarVaultId  String?   // Pointer to AadhaarVault entry (Aadhaar only)
  isVerified      Boolean   @default(false)
  verifiedAt      DateTime?
  verificationMode String?  // API | MANUAL | EKYC_OTP | EKYC_BIOMETRIC | OFFLINE_XML
  expiryDate      DateTime?
  documentUrl     String?   // Path to uploaded document image
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer        Customer  @relation(fields: [customerId], references: [id])

  @@unique([customerId, documentType])
  @@index([customerId])
}

// Separate encrypted table per ADR-007 — Aadhaar numbers stored here only
model AadhaarVault {
  id                    String   @id @default(cuid())
  encryptedAadhaarNumber String  // AES-256 encrypted
  lastFourDigits        String   // For display: xxxx-xxxx-{last4}
  createdAt             DateTime @default(now())

  // No relations to prevent accidental joins. Access via aadhaarVaultId on CustomerIdentity.
}

model CustomerAddress {
  id            String    @id @default(cuid())
  customerId    String
  type          String    // CURRENT | PERMANENT | OFFICE
  addressLine1  String
  addressLine2  String?
  city          String
  state         String
  pincode       String
  landmark      String?
  residingSince DateTime?
  ownershipType String?   // OWNED | RENTED | FAMILY | COMPANY_PROVIDED
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  customer      Customer  @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

model CustomerBankAccount {
  id              String    @id @default(cuid())
  customerId      String
  bankName        String
  branchName      String?
  ifscCode        String
  accountNumber   String    // Encrypted
  maskedAccount   String    // e.g., XXXXXXXX1234
  accountType     String    // SAVINGS | CURRENT | OVERDRAFT | NRO | NRE
  isPrimary       Boolean   @default(false)
  isVerified      Boolean   @default(false)
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer        Customer  @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

// ============================================================
// CONSENT MANAGEMENT
// ============================================================

model ConsentRecord {
  id              String    @id @default(cuid())
  companyId       String
  customerId      String
  consentType     String    // CREDIT_BUREAU_PULL | AADHAAR_EKYC | DPDP_DATA_PROCESSING | ACCOUNT_AGGREGATOR
  consentText     String    // Exact text shown to customer
  consentMode     String    // DIGITAL_CHECKBOX | ESIGN | PHYSICAL_FORM
  purpose         String    // e.g., "Loan application #LA-2026-001234"
  bureausConsented String?  // JSON array: ["CIBIL","EXPERIAN"] (for bureau consent)
  validityPeriod  Int?      // Days
  expiresAt       DateTime?
  isWithdrawn     Boolean   @default(false)
  withdrawnAt     DateTime?
  consentedAt     DateTime  @default(now())
  ipAddress       String?
  userAgent       String?

  customer        Customer  @relation(fields: [customerId], references: [id])

  @@index([companyId])
  @@index([customerId])
  @@index([consentType])
}

// ============================================================
// LOAN PRODUCTS
// ============================================================

model LoanProduct {
  id                  String   @id @default(cuid())
  companyId           String
  name                String
  code                String
  description         String?
  productType         String   // TERM_LOAN | BULLET | EMI | FLEXI | OVERDRAFT
  collateralType      String   @default("NONE") // NONE | GOLD | VEHICLE | PROPERTY | OTHER
  interestMethod      String   @default("DAILY_REDUCING") // DAILY_REDUCING | MONTHLY_REDUCING | FLAT_RATE
  dayCountConvention  String   @default("ACTUAL_ACTUAL") // ACTUAL_ACTUAL | THIRTY_360
  interestType        String   @default("FIXED") // FIXED | FLOATING | HYBRID
  minInterestRate     Int      // basis points (1200 = 12.00%)
  maxInterestRate     Int      // basis points
  defaultInterestRate Int      // basis points
  minTenureMonths     Int      @default(1)
  maxTenureMonths     Int      @default(360)
  minAmount           BigInt   // paise
  maxAmount           BigInt   // paise
  penalRateAdditional Int      @default(200) // basis points over normal rate (200 = 2%)
  prepaymentFeePercent Int     @default(0)   // basis points (0 = no prepayment fee)
  processingFeePercent Int     @default(100) // basis points (100 = 1%)
  processingFeeFlat   BigInt   @default(0)   // paise (if flat fee)
  emiRounding         String   @default("ROUND_UP_RUPEE") // ROUND_UP_RUPEE | ROUND_NEAREST_PAISA
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?
  createdBy           String?

  @@unique([companyId, code])
  @@index([companyId])
  @@index([isActive])
}

// ============================================================
// ACCOUNTING FOUNDATION
// ============================================================

model ChartOfAccount {
  id          String    @id @default(cuid())
  companyId   String
  code        String    // e.g., "1000", "1100", "2000"
  name        String    // e.g., "Cash and Bank", "Loan Portfolio"
  accountType String    // ASSET | LIABILITY | INCOME | EXPENSE | EQUITY
  parentId    String?   // Self-referential for hierarchy
  level       Int       @default(0) // 0 = top-level, 1 = sub-account, etc.
  isActive    Boolean   @default(true)
  isSystem    Boolean   @default(false) // System accounts can't be deleted
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  parent      ChartOfAccount?  @relation("AccountHierarchy", fields: [parentId], references: [id])
  children    ChartOfAccount[] @relation("AccountHierarchy")
  debitLines  JournalEntryLine[] @relation("DebitAccount")
  creditLines JournalEntryLine[] @relation("CreditAccount")

  @@unique([companyId, code])
  @@index([companyId])
  @@index([parentId])
  @@index([accountType])
}

model JournalEntry {
  id          String    @id @default(cuid())
  companyId   String
  entryNumber String    // Auto-generated: JV-2026-000001
  date        DateTime
  narration   String
  reference   String?   // Link to source: "DISBURSEMENT:clm1abc", "PAYMENT:clm2def"
  status      String    @default("POSTED") // DRAFT | POSTED | REVERSED
  reversalOf  String?   // ID of entry this reverses
  totalAmount BigInt    // Total debit (= total credit) in paise
  createdAt   DateTime  @default(now())
  createdBy   String?

  lines       JournalEntryLine[]

  @@unique([companyId, entryNumber])
  @@index([companyId])
  @@index([date])
  @@index([reference])
}

model JournalEntryLine {
  id              String   @id @default(cuid())
  journalEntryId  String
  accountId       String
  debitAmount     BigInt   @default(0) // paise
  creditAmount    BigInt   @default(0) // paise
  narration       String?

  journalEntry    JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  debitAccount    ChartOfAccount @relation("DebitAccount", fields: [accountId], references: [id])
  creditAccount   ChartOfAccount @relation("CreditAccount", fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
}

// ============================================================
// LEADS
// ============================================================

model Lead {
  id              String    @id @default(cuid())
  companyId       String
  branchId        String?
  source          String    // WALK_IN | PHONE | WEB | DSA | REFERRAL
  dsaPartnerId    String?
  referralCode    String?
  customerName    String
  phone           String
  email           String?
  loanProductId   String?
  requestedAmount BigInt?   // paise
  assignedTo      String?   // userId
  status          String    @default("NEW") // NEW | CONTACTED | INTERESTED | CONVERTED | REJECTED | LOST
  notes           String?
  convertedToApplicationId String?
  nextFollowUpAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  createdBy       String?

  followUps       LeadFollowUp[]

  @@index([companyId])
  @@index([status])
  @@index([assignedTo])
  @@index([createdAt])
}

model LeadFollowUp {
  id        String   @id @default(cuid())
  leadId    String
  type      String   // CALL | VISIT | EMAIL | SMS | WHATSAPP
  notes     String
  outcome   String?  // INTERESTED | NOT_INTERESTED | CALLBACK | NO_ANSWER | CONVERTED
  followedBy String?
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

// ============================================================
// LOAN APPLICATIONS (LOS)
// ============================================================

model LoanApplication {
  id                String    @id @default(cuid())
  companyId         String
  branchId          String?
  applicationNumber String    // Auto-generated: LA-2026-000001
  customerId        String
  loanProductId     String
  leadId            String?   // Source lead (if converted from lead)
  requestedAmount   BigInt    // paise
  approvedAmount    BigInt?   // paise (may differ from requested)
  interestRateBps   Int?      // basis points (set at sanction)
  tenureMonths      Int
  purpose           String?
  status            String    @default("DRAFT")
  // DRAFT | SUBMITTED | UNDER_REVIEW | APPROVED | SANCTIONED |
  // DISBURSEMENT_PENDING | DISBURSED | REJECTED | CANCELLED
  rejectionReason   String?
  rejectionCode     String?
  rejectedBy        String?
  rejectedAt        DateTime?
  sanctionedAt      DateTime?
  disbursedAt       DateTime?
  loanAccountId     String?   // Created on disbursement
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  createdBy         String?
  updatedBy         String?

  documents         Document[]
  appraisal         CreditAppraisal?
  approvalRequests  ApprovalRequest[]
  sanctionConditions SanctionCondition[]
  disbursement      Disbursement?

  @@unique([companyId, applicationNumber])
  @@index([companyId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================
// DOCUMENTS
// ============================================================

model Document {
  id                String    @id @default(cuid())
  companyId         String
  entityType        String    // CUSTOMER | LOAN_APPLICATION | LOAN_ACCOUNT
  entityId          String
  loanApplicationId String?
  documentType      String
  // PAN_CARD | AADHAAR | ADDRESS_PROOF | INCOME_PROOF | BANK_STATEMENT |
  // PHOTO | SALARY_SLIP | ITR | GST_CERTIFICATE | COLLATERAL_PHOTO |
  // LOAN_AGREEMENT | SANCTION_LETTER | KFS | NOC | RECEIPT | OTHER
  fileName          String
  filePath          String
  fileSize          Int?
  mimeType          String?
  status            String    @default("UPLOADED") // UPLOADED | VERIFIED | REJECTED | EXPIRED
  verifiedBy        String?
  verifiedAt        DateTime?
  rejectionReason   String?
  expiryDate        DateTime?
  templateVersion   String?   // For generated docs: which template version was used
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdBy         String?

  loanApplication   LoanApplication? @relation(fields: [loanApplicationId], references: [id])

  @@index([companyId])
  @@index([entityType, entityId])
  @@index([loanApplicationId])
  @@index([documentType])
}

// ============================================================
// CREDIT APPRAISAL
// ============================================================

model CreditAppraisal {
  id                  String    @id @default(cuid())
  loanApplicationId   String    @unique
  scorecardResults    String?   // JSON: checklist items with scores
  creditScore         Int?      // Bureau score if pulled
  creditPullId        String?   // Reference to future CreditPull
  riskCategory        String    @default("MEDIUM") // LOW | MEDIUM | HIGH
  recommendation      String?   // APPROVE | REJECT | REFER
  manualOverride      Boolean   @default(false)
  overrideReason      String?
  debtToIncomeRatio   Int?      // basis points (4500 = 45%)
  existingObligations BigInt?   // paise — existing EMIs from bureau/AA
  remarks             String?
  appraisedBy         String?
  appraisedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  loanApplication     LoanApplication @relation(fields: [loanApplicationId], references: [id])
}

// ============================================================
// APPROVAL WORKFLOW (Maker-Checker)
// ============================================================

model ApprovalRequest {
  id                  String    @id @default(cuid())
  companyId           String
  entityType          String    // LOAN_APPLICATION | PAYMENT_WAIVER | WRITE_OFF | etc.
  entityId            String
  loanApplicationId   String?
  level               Int       @default(1) // Approval level (1, 2, 3...)
  requiredLevels      Int       @default(1) // Total levels needed
  status              String    @default("PENDING") // PENDING | APPROVED | REJECTED
  requestedBy         String
  requestedAt         DateTime  @default(now())
  approvedBy          String?
  approvedAt          DateTime?
  rejectedBy          String?
  rejectedAt          DateTime?
  remarks             String?

  loanApplication     LoanApplication? @relation(fields: [loanApplicationId], references: [id])

  @@index([companyId])
  @@index([entityType, entityId])
  @@index([status])
  @@index([loanApplicationId])
}

// ============================================================
// SANCTION CONDITIONS
// ============================================================

model SanctionCondition {
  id                  String    @id @default(cuid())
  loanApplicationId   String
  condition           String    // Description of the condition
  isMandatory         Boolean   @default(true)
  isMet               Boolean   @default(false)
  metAt               DateTime?
  verifiedBy          String?
  remarks             String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  loanApplication     LoanApplication @relation(fields: [loanApplicationId], references: [id])

  @@index([loanApplicationId])
}

// ============================================================
// DISBURSEMENT
// ============================================================

model Disbursement {
  id                  String    @id @default(cuid())
  loanApplicationId   String    @unique
  amount              BigInt    // paise — actual disbursed amount
  mode                String    // NEFT | RTGS | IMPS | CHEQUE | CASH
  bankAccountId       String?   // Customer bank account
  referenceNumber     String?   // Transaction reference
  disbursedAt         DateTime
  disbursedBy         String
  kfsDocumentId       String?   // Generated KFS document
  agreementDocumentId String?   // Generated agreement document
  journalEntryId      String?   // Accounting entry
  remarks             String?
  createdAt           DateTime  @default(now())

  loanApplication     LoanApplication @relation(fields: [loanApplicationId], references: [id])

  @@index([loanApplicationId])
}

// ============================================================
// LOAN ACCOUNTS (Active Loans)
// ============================================================

model LoanAccount {
  id                  String    @id @default(cuid())
  companyId           String
  branchId            String?
  accountNumber       String    // Auto-generated: LN-2026-000001
  loanApplicationId   String    @unique
  customerId          String
  loanProductId       String
  principalAmount     BigInt    // paise — original disbursed
  outstandingPrincipal BigInt   // paise — current outstanding
  interestRateBps     Int       // basis points
  interestMethod      String    // DAILY_REDUCING | MONTHLY_REDUCING | FLAT_RATE
  interestType        String    @default("FIXED") // FIXED | FLOATING | HYBRID
  tenureMonths        Int
  emiAmount           BigInt    // paise — standard EMI
  disbursedAt         DateTime
  maturityDate        DateTime
  nextEmiDate         DateTime?
  dpd                 Int       @default(0) // Days Past Due
  smaClassification   String?   // SMA_0 | SMA_1 | SMA_2
  npaClassification   String?   // SUB_STANDARD | DOUBTFUL | LOSS
  npaDate             DateTime?
  status              String    @default("ACTIVE")
  // ACTIVE | OVERDUE | NPA | CLOSED | WRITTEN_OFF | SETTLED | FORECLOSED
  closedAt            DateTime?
  closureType         String?   // NORMAL | FORECLOSURE | SETTLEMENT | WRITE_OFF
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  emiSchedule         EmiScheduleRow[]
  payments            Payment[]

  @@unique([companyId, accountNumber])
  @@index([companyId])
  @@index([customerId])
  @@index([status])
  @@index([dpd])
}

model EmiScheduleRow {
  id                  String    @id @default(cuid())
  loanAccountId       String
  installmentNumber   Int
  dueDate             DateTime
  emiAmount           BigInt    // paise
  principalComponent  BigInt    // paise
  interestComponent   BigInt    // paise
  openingBalance      BigInt    // paise
  closingBalance      BigInt    // paise
  status              String    @default("UPCOMING")
  // UPCOMING | DUE | PAID | PARTIALLY_PAID | OVERDUE
  paidAmount          BigInt    @default(0) // paise
  paidDate            DateTime?
  daysOverdue         Int       @default(0)
  penalInterest       BigInt    @default(0) // paise

  loanAccount         LoanAccount @relation(fields: [loanAccountId], references: [id])

  @@unique([loanAccountId, installmentNumber])
  @@index([loanAccountId])
  @@index([dueDate])
  @@index([status])
}

model Payment {
  id                  String    @id @default(cuid())
  companyId           String
  loanAccountId       String
  amount              BigInt    // paise — total payment amount
  mode                String    // CASH | CHEQUE | UPI | NEFT | NACH | RTGS
  referenceNumber     String?
  receivedDate        DateTime
  allocatedToPrincipal BigInt   @default(0) // paise
  allocatedToInterest  BigInt   @default(0) // paise
  allocatedToPenalty   BigInt   @default(0) // paise
  allocatedToFees      BigInt   @default(0) // paise
  isBounced           Boolean  @default(false)
  bounceReason        String?
  bounceCharges       BigInt   @default(0) // paise
  status              String   @default("RECEIVED") // RECEIVED | ALLOCATED | BOUNCED | REVERSED
  receiptNumber       String?
  receiptDocumentId   String?
  journalEntryId      String?
  createdAt           DateTime @default(now())
  createdBy           String?

  loanAccount         LoanAccount @relation(fields: [loanAccountId], references: [id])

  @@index([companyId])
  @@index([loanAccountId])
  @@index([receivedDate])
  @@index([status])
}

// ============================================================
// GOLD LOAN OPERATIONS
// ============================================================

model GoldAppraisal {
  id              String   @id @default(cuid())
  companyId       String
  loanAccountId   String?
  loanApplicationId String?
  itemDescription String   // "22K Gold Chain", "24K Gold Bangle"
  grossWeight     Int      // milligrams (1000 = 1 gram)
  purity          Int      // karat (22, 24, etc.)
  stoneDeduction  Int      @default(0) // milligrams
  netWeight       Int      // grossWeight - stoneDeduction (milligrams)
  ratePerGram     BigInt   // paise per gram (from daily gold rate)
  valuationAmount BigInt   // paise = netWeight/1000 * ratePerGram * purity/24
  ltvPercent      Int      @default(7500) // basis points (7500 = 75%)
  maxLoanAmount   BigInt   // paise = valuationAmount * ltvPercent / 10000
  packetId        String?  // Vault packet reference
  vaultBranchId   String?  // Branch where gold is stored
  photoUrl        String?
  status          String   @default("APPRAISED") // APPRAISED | PLEDGED | RELEASED | AUCTIONED
  releasedAt      DateTime?
  auctionedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  appraisedBy     String?

  @@index([companyId])
  @@index([loanAccountId])
  @@index([status])
}

model GoldRate {
  id          String   @id @default(cuid())
  companyId   String
  date        DateTime
  rate22K     BigInt   // paise per gram for 22K
  rate24K     BigInt   // paise per gram for 24K
  source      String   @default("MANUAL") // MANUAL | IBJA
  createdAt   DateTime @default(now())
  createdBy   String?

  @@unique([companyId, date])
  @@index([companyId])
}

model GoldAuction {
  id              String    @id @default(cuid())
  companyId       String
  loanAccountId   String
  appraisalId     String
  noticeDate      DateTime  // Must be >= 14 days before auction
  auctionDate     DateTime
  reservePrice    BigInt    // paise — minimum bid
  soldPrice       BigInt?   // paise — actual sale price
  surplusAmount   BigInt?   // paise — returned to borrower (soldPrice - outstanding)
  buyerDetails    String?
  status          String    @default("NOTICE_SENT") // NOTICE_SENT | SCHEDULED | COMPLETED | CANCELLED
  noticeDocumentId String?
  createdAt       DateTime  @default(now())
  createdBy       String?

  @@index([companyId])
  @@index([loanAccountId])
}

// ============================================================
// VEHICLE LOAN OPERATIONS
// ============================================================

model VehicleDetail {
  id              String    @id @default(cuid())
  companyId       String
  loanAccountId   String?
  loanApplicationId String?
  vehicleType     String    // TWO_WHEELER | CAR | COMMERCIAL | TRACTOR
  make            String    // Maruti, Honda, etc.
  model           String    // Swift, City, etc.
  variant         String?
  yearOfMfg       Int
  registrationNo  String?
  engineNo        String?
  chassisNo       String?
  color           String?
  purchasePrice   BigInt?   // paise
  hypothecationStatus String @default("PENDING") // PENDING | FILED | REMOVED
  hypothecationFiledAt DateTime?
  hypothecationRemovedAt DateTime?
  rtoCode         String?
  insuranceProvider String?
  insurancePolicyNo String?
  insuranceExpiryDate DateTime?
  repossessed     Boolean   @default(false)
  repossessedAt   DateTime?
  repossessionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId])
  @@index([loanAccountId])
  @@index([registrationNo])
}

model Dealer {
  id              String    @id @default(cuid())
  companyId       String
  name            String
  contactPerson   String?
  phone           String?
  email           String?
  address         String?
  city            String?
  state           String?
  gstNumber       String?
  dealerType      String    @default("VEHICLE") // VEHICLE | EQUIPMENT
  status          String    @default("ACTIVE") // ACTIVE | SUSPENDED | TERMINATED
  totalLoansSourced Int     @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([companyId])
}

// ============================================================
// MICROFINANCE OPERATIONS
// ============================================================

model MfiGroup {
  id              String    @id @default(cuid())
  companyId       String
  branchId        String?
  groupName       String
  groupCode       String
  groupType       String    @default("JLG") // JLG | SHG
  centerId        String?
  fieldOfficerId  String?   // Assigned officer
  formationDate   DateTime
  memberCount     Int       @default(0)
  status          String    @default("ACTIVE") // ACTIVE | DISSOLVED
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  members         MfiGroupMember[]
  meetings        MfiMeeting[]

  @@unique([companyId, groupCode])
  @@index([companyId])
  @@index([branchId])
}

model MfiGroupMember {
  id              String    @id @default(cuid())
  groupId         String
  customerId      String
  role            String    @default("MEMBER") // LEADER | SECRETARY | MEMBER
  joinedAt        DateTime  @default(now())
  leftAt          DateTime?
  status          String    @default("ACTIVE") // ACTIVE | LEFT | DEFAULTED

  group           MfiGroup  @relation(fields: [groupId], references: [id])

  @@unique([groupId, customerId])
  @@index([groupId])
  @@index([customerId])
}

model MfiMeeting {
  id              String    @id @default(cuid())
  groupId         String
  meetingDate     DateTime
  meetingType     String    @default("REGULAR") // REGULAR | CGT | SPECIAL
  attendance      String?   // JSON: [{customerId, present: bool}]
  collectionAmount BigInt?  // paise — total collected at meeting
  notes           String?
  conductedBy     String?
  status          String    @default("SCHEDULED") // SCHEDULED | COMPLETED | CANCELLED
  createdAt       DateTime  @default(now())

  group           MfiGroup  @relation(fields: [groupId], references: [id])

  @@index([groupId])
  @@index([meetingDate])
}

// ============================================================
// CO-LENDING & LOAN ASSIGNMENT
// ============================================================

model CoLendingPartner {
  id              String    @id @default(cuid())
  companyId       String
  partnerName     String
  partnerType     String    // BANK | NBFC | HFC
  contactPerson   String?
  phone           String?
  email           String?
  agreementDate   DateTime?
  defaultNbfcSharePct Int   @default(2000) // basis points (2000 = 20%)
  status          String    @default("ACTIVE") // ACTIVE | SUSPENDED | TERMINATED
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  coLendingLoans  CoLendingLoan[]

  @@index([companyId])
}

model CoLendingLoan {
  id              String    @id @default(cuid())
  loanAccountId   String
  partnerId       String
  model           String    // CLM1 | LOAN_ASSIGNMENT
  nbfcSharePct    Int       // basis points (2000 = 20%)
  partnerSharePct Int       // basis points (8000 = 80%)
  nbfcAmount      BigInt    // paise
  partnerAmount   BigInt    // paise
  servicingRights String    @default("NBFC") // NBFC | PARTNER | SHARED
  status          String    @default("ACTIVE") // ACTIVE | SETTLED | BUYBACK
  assignmentDate  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  partner         CoLendingPartner @relation(fields: [partnerId], references: [id])

  @@index([loanAccountId])
  @@index([partnerId])
}

// ============================================================
// CREDIT LIFE INSURANCE
// ============================================================

model InsurancePolicy {
  id              String    @id @default(cuid())
  companyId       String
  loanAccountId   String
  customerId      String
  provider        String
  policyNumber    String
  policyType      String    @default("CREDIT_LIFE") // CREDIT_LIFE | HEALTH | PROPERTY | VEHICLE
  coverAmount     BigInt    // paise — sum assured
  premiumAmount   BigInt    // paise — total premium
  premiumGst      BigInt    @default(0) // paise
  premiumMode     String    @default("SINGLE_UPFRONT") // SINGLE_UPFRONT | MONTHLY | ANNUAL
  startDate       DateTime
  endDate         DateTime
  nomineeName     String?
  nomineeRelation String?
  bundledWithLoan Boolean   @default(false)
  borrowerConsented Boolean @default(true)
  status          String    @default("ACTIVE") // ACTIVE | LAPSED | CLAIMED | CANCELLED | EXPIRED
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId])
  @@index([loanAccountId])
  @@index([customerId])
}

// ============================================================
// DSA / PARTNER CHANNEL
// ============================================================

model DsaPartner {
  id              String    @id @default(cuid())
  companyId       String
  type            String    @default("INDIVIDUAL") // INDIVIDUAL | CORPORATE | FINTECH
  name            String
  contactPerson   String?
  phone           String
  email           String?
  panNumber       String?
  gstNumber       String?
  address         String?
  commissionPct   Int       @default(100) // basis points (100 = 1%)
  tdsRatePct      Int       @default(500) // basis points (500 = 5%)
  apiEnabled      Boolean   @default(false)
  apiKeyHash      String?   // Hashed API key
  status          String    @default("ACTIVE") // ACTIVE | SUSPENDED | TERMINATED
  clawbackMonths  Int       @default(3) // Clawback period
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  payouts         DsaPayout[]

  @@index([companyId])
}

model DsaPayout {
  id              String    @id @default(cuid())
  dsaPartnerId    String
  loanAccountId   String
  loanAmount      BigInt    // paise — disbursed amount
  commissionAmount BigInt   // paise
  gstOnCommission BigInt    @default(0) // paise
  tdsDeducted     BigInt    @default(0) // paise
  netPayout       BigInt    // paise
  status          String    @default("CALCULATED") // CALCULATED | APPROVED | PAID | CLAWED_BACK
  paidAt          DateTime?
  paymentReference String?
  clawedBack      Boolean   @default(false)
  clawbackReason  String?
  createdAt       DateTime  @default(now())

  dsaPartner      DsaPartner @relation(fields: [dsaPartnerId], references: [id])

  @@index([dsaPartnerId])
  @@index([loanAccountId])
}

// ============================================================
// TREASURY & FUND MANAGEMENT
// ============================================================

model Borrowing {
  id              String    @id @default(cuid())
  companyId       String
  lenderName      String    // Bank or institution name
  facilityType    String    // TERM_LOAN | OD | NCD | CP | WORKING_CAPITAL
  sanctionAmount  BigInt    // paise
  outstandingAmount BigInt  // paise
  interestRateBps Int       // basis points
  startDate       DateTime
  maturityDate    DateTime
  repaymentFrequency String @default("MONTHLY") // MONTHLY | QUARTERLY | BULLET
  status          String    @default("ACTIVE") // ACTIVE | CLOSED | RESTRUCTURED
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String?

  @@index([companyId])
  @@index([status])
}

model Investment {
  id              String    @id @default(cuid())
  companyId       String
  investmentType  String    // FD | MUTUAL_FUND | GOVT_SECURITIES | BONDS
  institution     String
  amount          BigInt    // paise
  interestRateBps Int?
  startDate       DateTime
  maturityDate    DateTime?
  currentValue    BigInt?   // paise
  status          String    @default("ACTIVE") // ACTIVE | MATURED | REDEEMED
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String?

  @@index([companyId])
}

// ============================================================
// EMPLOYEE & HR
// ============================================================

model Employee {
  id              String    @id @default(cuid())
  companyId       String
  userId          String?   // Link to User (if they have system access)
  employeeCode    String
  firstName       String
  lastName        String?
  phone           String?
  email           String?
  designation     String?
  department      String?
  branchId        String?
  reportingTo     String?   // Employee ID of manager
  dateOfJoining   DateTime
  dateOfLeaving   DateTime?
  status          String    @default("ACTIVE") // ACTIVE | ON_LEAVE | RESIGNED | TERMINATED
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  targets         EmployeeTarget[]
  attendance      Attendance[]

  @@unique([companyId, employeeCode])
  @@index([companyId])
  @@index([branchId])
}

model Attendance {
  id          String    @id @default(cuid())
  employeeId  String
  date        DateTime
  checkIn     DateTime?
  checkOut    DateTime?
  status      String    @default("PRESENT") // PRESENT | ABSENT | HALF_DAY | LEAVE | HOLIDAY
  leaveType   String?   // CASUAL | SICK | EARNED | UNPAID
  remarks     String?
  createdAt   DateTime  @default(now())

  employee    Employee  @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
}

model EmployeeTarget {
  id              String    @id @default(cuid())
  employeeId      String
  targetType      String    // DISBURSEMENT_AMOUNT | DISBURSEMENT_COUNT | COLLECTION_AMOUNT | COLLECTION_COUNT | LEADS
  targetPeriod    String    // MONTHLY | QUARTERLY | ANNUAL
  periodStart     DateTime
  periodEnd       DateTime
  targetValue     BigInt    // paise for amounts, count for counts
  achievedValue   BigInt    @default(0)
  status          String    @default("ACTIVE") // ACTIVE | COMPLETED | EXPIRED
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  employee        Employee  @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([targetType, periodStart])
}

// ============================================================
// TASK & WORKFLOW MANAGEMENT
// ============================================================

model Task {
  id              String    @id @default(cuid())
  companyId       String
  title           String
  description     String?
  taskType        String    // FOLLOW_UP | VERIFICATION | APPROVAL | REVIEW | COLLECTION | GENERAL
  priority        String    @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  status          String    @default("OPEN") // OPEN | IN_PROGRESS | COMPLETED | CANCELLED | ESCALATED
  assignedTo      String?   // User ID
  assignedBy      String?
  relatedEntity   String?   // "LoanApplication:clm1abc" or "Lead:clm2def"
  dueDate         DateTime?
  completedAt     DateTime?
  escalatedTo     String?   // Manager user ID
  escalatedAt     DateTime?
  escalationReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  comments        TaskComment[]

  @@index([companyId])
  @@index([assignedTo])
  @@index([status])
  @@index([dueDate])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  comment   String
  createdAt DateTime @default(now())

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// ============================================================
// EARLY WARNING SYSTEM
// ============================================================

model EwsRule {
  id              String    @id @default(cuid())
  companyId       String
  name            String
  category        String    // REPAYMENT | BUREAU | ACCOUNT | BEHAVIORAL
  triggerCondition String   // JSON rule definition
  severity        String    // LOW | MEDIUM | HIGH | CRITICAL
  autoAction      String    @default("NONE") // NONE | NOTIFY_OFFICER | CREATE_TASK | FLAG_ACCOUNT
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  alerts          EwsAlert[]

  @@index([companyId])
  @@index([isActive])
}

model EwsAlert {
  id              String    @id @default(cuid())
  companyId       String
  loanAccountId   String
  customerId      String?
  ruleId          String?
  severity        String    // LOW | MEDIUM | HIGH | CRITICAL
  signalType      String    // Description of what triggered
  signalData      String?   // JSON details
  status          String    @default("NEW") // NEW | ACKNOWLEDGED | INVESTIGATING | RESOLVED | FALSE_POSITIVE
  acknowledgedBy  String?
  acknowledgedAt  DateTime?
  resolvedBy      String?
  resolvedAt      DateTime?
  resolutionNotes String?
  taskId          String?   // Auto-created task (if auto-action configured)
  createdAt       DateTime  @default(now())

  rule            EwsRule?  @relation(fields: [ruleId], references: [id])

  @@index([companyId])
  @@index([loanAccountId])
  @@index([status])
  @@index([severity])
  @@index([createdAt])
}

model EwsScore {
  id              String    @id @default(cuid())
  loanAccountId   String
  score           Int       // 0-100 (higher = more stress)
  riskBucket      String    // GREEN | YELLOW | ORANGE | RED
  components      String?   // JSON: {repayment, bureau, cashFlow, behavioral}
  previousScore   Int?
  trend           String?   // IMPROVING | STABLE | DETERIORATING
  calculatedAt    DateTime  @default(now())

  @@index([loanAccountId])
  @@index([riskBucket])
  @@index([calculatedAt])
}
